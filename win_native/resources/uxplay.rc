// SPDX-License-Identifier: MIT
// Resources of the executable.  Product name and version come from
// win_native/include/uxplay_version.h, the one place they are written.
#include <winver.h>
#include "../include/uxplay_version.h"

1 ICON "uxplay.ico"
1 24 "uxplay.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION UXPLAY_VERSION_MAJOR,UXPLAY_VERSION_MINOR,UXPLAY_VERSION_PATCH,0
PRODUCTVERSION UXPLAY_VERSION_MAJOR,UXPLAY_VERSION_MINOR,UXPLAY_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", UXPLAY_COMPANY_NAME
            VALUE "FileDescription", UXPLAY_FILE_DESCRIPTION
            VALUE "FileVersion", UXPLAY_VERSION_TEXT
            VALUE "InternalName", UXPLAY_PRODUCT_FILE_NAME
            VALUE "LegalCopyright", UXPLAY_COPYRIGHT
            VALUE "OriginalFilename", UXPLAY_EXECUTABLE_NAME
            VALUE "ProductName", UXPLAY_PRODUCT_NAME
            VALUE "ProductVersion", UXPLAY_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
