// SPDX-License-Identifier: MIT
// Resources of the Windows-native UxPlay executable.
#include <winver.h>

1 ICON "uxplay.ico"
1 24 "uxplay.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,74,0,0
PRODUCTVERSION 1,74,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UxPlay (GPL-3.0)"
            VALUE "FileDescription", "UxPlay AirPlay + USB mirroring receiver (Windows-native)"
            VALUE "FileVersion", "1.74-native"
            VALUE "InternalName", "uxplay"
            VALUE "LegalCopyright", "UxPlay authors, GPL-3.0-or-later"
            VALUE "OriginalFilename", "uxplay.exe"
            VALUE "ProductName", "UxPlay"
            VALUE "ProductVersion", "1.74-native"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
