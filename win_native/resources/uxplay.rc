// SPDX-License-Identifier: MIT
// Resources of the Windows-native UxPlay executable.  The version comes from
// win_native/include/uxplay_version.h, the one place it is written.
#include <winver.h>
#include "../include/uxplay_version.h"

1 ICON "uxplay.ico"
1 24 "uxplay.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION UXPLAY_VERSION_MAJOR,UXPLAY_VERSION_MINOR,UXPLAY_VERSION_PATCH,0
PRODUCTVERSION UXPLAY_VERSION_MAJOR,UXPLAY_VERSION_MINOR,UXPLAY_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UxPlay open-source project"
            VALUE "FileDescription", "UxPlay screen mirroring receiver"
            VALUE "FileVersion", UXPLAY_VERSION_TEXT
            VALUE "InternalName", "uxplay"
            VALUE "LegalCopyright", "UxPlay authors. GPL-3.0-or-later."
            VALUE "OriginalFilename", "uxplay.exe"
            VALUE "ProductName", "UxPlay"
            VALUE "ProductVersion", UXPLAY_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
